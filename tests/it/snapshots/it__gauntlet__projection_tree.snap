{
  "enabledPlugins": {
    "formatter@acme-marketplace": true
  },
  "extraKnownMarketplaces": {
    "acme-marketplace": {
      "source": "./vendor/acme-marketplace"
    }
  },
  "hooks": {
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://hooks.example.com/audit"
          }
        ],
        "matcher": "Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "temper reporter",
            "type": "command"
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(cargo build:*)"
    ]
  }
}

