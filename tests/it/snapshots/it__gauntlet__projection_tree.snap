shape = "fields"
collection_address = { key_path = "enabledPlugins.*", entry_shape = "scalar(enabled)" }

[[declaration.kind]]
name = "known-marketplace"
governs_root = ".claude"
governs_glob = "settings.json"
unit_shape = "file"
