[[declaration.kind]]
name = "machine"
governs_root = ".claude/local"
governs_glob = "*.md"
commitment = "local"
format = "yaml-frontmatter"
unit_shape = "file"

[[declaration.kind]]
name = "rule"
governs_root = ".claude/rules"
governs_glob = "**/*.md"
format = "yaml-frontmatter"
unit_shape = "file"
registration = ["paths-match(paths)"]
templates = [{ kind = "citation" }]
guidance = "a rule reaches context on one of two schedules: with no `paths` frontmatter it loads at launch, beside `CLAUDE.md`; with `paths` it loads the first time Read, Write or Edit touches a matching file, once per session. So keep a rule to facts Claude should hold whenever the rule is loaded — concrete enough to verify ('use 2-space indentation', not 'format code properly'). If an entry is a multi-step procedure or only matters occasionally, it belongs in a skill, whose body loads only when invoked, rather than a rule, which loads whole once its scope opens. Prefer path-scoped rules when one convention governs scattered paths; prefer per-directory CLAUDE.md when directory owners maintain their own. Treat rules like code: prune them when behavior drifts, and test a change by watching whether Claude's behavior actually shifts."
cite = "https://code.claude.com/docs/en/memory (retrieved 2026-11-25); path-rule load timing observed on Claude Code 2.1.332"

[[declaration.kind]]
name = "settings"
governs_root = ".claude"
governs_glob = "settings.json"
format = "json-document"
unit_shape = "file"

[[declaration.kind]]
name = "spec"
unit_shape = "file"
content = { regions = [{ region = "prose" }, { region = "field", slot = "intent" }, { region = "collection", member_kind = "invariant" }] }

[[declaration.clause]]
label = "decision.required.status"
kind = "decision"
predicate = "required"
field = "status"
severity = "required"

[[declaration.clause]]
label = "invariant.required.test"
kind = "invariant"
predicate = "required"
field = "test"
severity = "advisory"

[[declaration.clause]]
label = "machine.type.mode"
kind = "machine"
predicate = "type"
field = "mode"
severity = "advisory"
value_type = ["string"]

[[declaration.clause]]
label = "spec.required.invariant[*].test"
kind = "spec"
predicate = "required"
field = "invariant[*].test"
severity = "advisory"

[[declaration.clause]]
label = "root.reachable"
predicate = "reachable"
severity = "advisory"
guidance = "This member is authored but unreachable: every registration channel its kind declares is provably dead, and no member that is reachable imports it. Claude never loads it, so it is context you maintain and never pay for — and a reader of the tree cannot tell it from live configuration. Three remedies: open a channel (give the `paths` globs a file they match, give the `description` trigger words), import it from a member that is reachable, or delete it. Advisory because a dead edge is a legitimate work-in-progress state; dial it or re-declare the clause `required` once your tree should hold the line."
cite = "https://code.claude.com/docs/en/memory#path-specific-rules (retrieved 2026-07-15); https://code.claude.com/docs/en/skills (retrieved 2026-07-16)"

[[declaration.clause]]
label = "root.fresh"
predicate = "fresh"
severity = "advisory"
guidance = "A lock row this member owns no longer matches disk: either its committed projection was hand-edited, or a fingerprinted source dependency has moved: a layout import, a prose include, a declared input, or — on the root member — a module the program itself loaded. Nothing reverse-parses a projection back into the program, so the two sides stay apart until you reconcile them: edit the owning source and re-emit, and for a moved declared input re-verify the member's claims against the new bytes first. Advisory because a drifted checkout is usually one `emit` away and blocking every such run would be temper's escalation, not yours; dial this label to `required` — or re-declare the clause — once a drifted projection should fail CI."

[[declaration.clause]]
label = "root.locus-declared"
predicate = "locus-declared"
severity = "advisory"
guidance = "A document sits at a governed locus that your program declares no member for. temper maintains nothing about it: `emit` never reaps it, and where your registrations write into it, `emit` renders their entries and refuses to delete any key it does not own; `guard` never bound it, and every address under it resolves to nothing — so it reads as governed configuration while being governed by no one. Where the locus is one the harness itself loads — a built-in kind's — it is live context on top of that; where the kind is your own, who reads it is yours to know and not temper's to claim. Declare the member in the program and re-emit; for a directory whose documents are authored in place rather than projected, declare its kind `local` so `check` derives the rows at read time instead. Advisory because a tree mid-adoption legitimately carries documents the program has not reached yet; dial this label to `required` — or re-declare the clause — once every document at a governed locus should be one you declared."

[[declaration.clause]]
label = "root.engine-matches"
predicate = "engine-matches"
severity = "advisory"
guidance = "Your committed lock records a different temper version than the one running this gate. The rows being read were compiled by a compiler this binary is not, so every verdict below rests on a translation: an older spelling normalizes at read time, but a genuine change in what a row means reads the same from the inside. Re-run `emit` — it rewrites the lock whole in this engine's canonical form, and the stamp goes back to matching. Advisory because a lagging stamp is the ordinary state of every checkout between an upgrade and the next emit, and blocking there would make an upgrade a hard stop; dial this label to `required` — or re-declare the clause — once your CI should refuse a lock it did not compile."

